# Copy this to .env and update as needed

# Path to the SQLite database of seen articles
DB_PATH=

# URL of the HN Tops stories
HN_BASE_URL=https://hacker-news.firebaseio.com/v0

# API key for Sendgrid to send out the digest - if using Sedngrid
SENDGRID_API_KEY=

# E-mail address the digest is sent on behalf of
FROM_EMAIL=

# E-mail address that should receive the digest mail
RECIPIENT_EMAIL=

# AWS credentials to send out the digest - if using Amazon SS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS=
AWS_REGION=
